# ---- Server ----
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth ----
# Change this to a long random string in production!
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Database ----
# For development, SQLite is used automatically (data/savings.db).
# For production, set DATABASE_URL to a PostgreSQL connection string.
# DATABASE_URL=postgres://user:password@localhost:5432/savings

# ---- Firebase (optional, for Google/Email login verification) ----
# If set, the /auth/firebase endpoint verifies Firebase ID tokens.
# FIREBASE_PROJECT_ID=
