# ---- Server ----
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth ----
# Change this to a long random string in production!
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public base URL of the app, used to build email verification links.
# In production set this to your deployed URL, e.g. https://your-app.onrender.com
APP_URL=http://localhost:5173

# ---- Email verification (Resend) ----
# New email accounts must verify their address before they can log in.
# Create an API key at https://resend.com and set it here to send real emails.
# If RESEND_API_KEY is unset, the verification link is printed to the server
# console instead (handy for local development).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# From address — must be on a Resend-verified domain in production.
# RESEND_FROM=Smart Savings Tracker <onboarding@resend.dev>

# ---- Database ----
# For development, SQLite is used automatically (data/savings.db).
# For production, set DATABASE_URL to a PostgreSQL connection string.
# DATABASE_URL=postgres://user:password@localhost:5432/savings

# ---- Firebase (optional, for Google/Email login verification) ----
# If set, the /auth/firebase endpoint verifies Firebase ID tokens.
# FIREBASE_PROJECT_ID=
